# =====================================================================
#  HUB DE MARKETING UNIFICADO — CANALI COMPANY
#  Copie este arquivo para .env.local e preencha os valores.
#  NUNCA versione o .env.local — ele contém segredos.
# =====================================================================

# ---------------------------------------------------------------------
#  SUPABASE  (obrigatório)
#  Supabase > Project Settings > API
# ---------------------------------------------------------------------

# URL do projeto e chave pública. Vão para o browser — são seguras de expor,
# pois o acesso é limitado pelas policies de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: IGNORA o RLS. Só existe no servidor.
# Jamais prefixe com NEXT_PUBLIC_ e jamais use em componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------
#  COFRE DE SENHAS  (obrigatório para o Bloco 4)
# ---------------------------------------------------------------------

# Chave AES-256 usada para cifrar as credenciais.
#   Gere com:  npm run vault:keygen
# ATENÇÃO: trocar esta chave torna ILEGÍVEIS todas as senhas já cifradas.
VAULT_ENCRYPTION_KEY=

# Hash scrypt da Senha Mestre.
#   Gere com:  npm run vault:hash -- "sua-senha-forte"
# Se definida, tem precedência sobre a senha cadastrada pelo painel admin.
# Deixe em branco para gerenciar a senha pela tela /admin/cofre.
VAULT_MASTER_PASSWORD_HASH=

# Opcional: segredo próprio para assinar a sessão de 15 min do cofre.
# Sem ele, a assinatura é derivada da VAULT_ENCRYPTION_KEY.
VAULT_SESSION_SECRET=


# ---------------------------------------------------------------------
#  WEBHOOKS DE VENDAS
#  Política fail-closed: endpoint sem segredo configurado RECUSA o webhook.
# ---------------------------------------------------------------------

# HOTMART — Ferramentas > Webhook > cadastre a URL e copie o hottok gerado.
#   URL: https://SEU-DOMINIO/api/webhooks/hotmart   (versão 2.0.0)
HOTMART_HOTTOK=

# ONPROFIT — defina ao menos um dos dois.
#   URL: https://SEU-DOMINIO/api/webhooks/onprofit
# TOKEN  = comparação direta do header x-webhook-token / Authorization
# SECRET = HMAC-SHA256 do corpo cru, enviado em x-signature
ONPROFIT_WEBHOOK_TOKEN=
ONPROFIT_WEBHOOK_SECRET=

# TMB — mesma lógica da OnProfit.
#   URL: https://SEU-DOMINIO/api/webhooks/tmb
TMB_WEBHOOK_TOKEN=
TMB_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
#  META ADS  (investimento em tráfego)
#  O Meta não envia gasto por webhook — os dados são puxados por job.
# ---------------------------------------------------------------------

# Token de acesso com permissão ads_read (Meta Business > Apps).
META_ADS_ACCESS_TOKEN=

# ID da conta de anúncios, com ou sem o prefixo act_.
# Para VÁRIAS contas, separe por vírgula — o gasto de todas é somado no painel:
#   META_ADS_ACCOUNT_ID=act_111111111111,act_222222222222
META_ADS_ACCOUNT_ID=act_000000000000

# Versão da Graph API (opcional; padrão v21.0).
META_API_VERSION=v21.0

# Protege /api/integrations/meta-ads/sync. O Vercel Cron envia este valor
# como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=


# ---------------------------------------------------------------------
#  ACESSO AO HUB
# ---------------------------------------------------------------------
#
# Não há variável de senha aqui — e isso é de propósito.
#
# O Hub inteiro exige login individual por e-mail (link mágico do Supabase
# Auth). Quem pode entrar está na tabela `colaboradores_autorizados`, e o
# próprio banco confere essa lista via RLS: sem estar nela, nem o Hub nem
# a API REST do Supabase devolvem uma linha sequer.
#
# Para gerenciar quem entra, use /admin/colaboradores.
#
# No painel do Supabase, confira em Authentication > URL Configuration:
#   Site URL         = https://SEU-DOMINIO
#   Redirect URLs    = https://SEU-DOMINIO/auth/callback
# Sem isso o link mágico chega apontando para localhost.
#
# (A antiga ADMIN_PASSWORD foi removida: era uma senha compartilhada, sem
#  revogação individual nem registro de quem entrou. O papel 'admin' na
#  lista de colaboradores substitui com folga.)
